    <!-- Onboarding -->
    <string name="onboarding_welcome_title">欢迎使用 DiLink-Auto</string>
    <string name="onboarding_welcome_desc">在汽车中控大屏上无缝使用手机应用。请先进行简单的权限设置以确保正常运行。</string>
    <string name="onboarding_files_title">所有文件访问权限</string>
    <string name="onboarding_files_desc">用于在手机存储中部署虚拟显示器服务端。若缺少该权限，车机将无法启动屏幕投屏。</string>
    <string name="onboarding_battery_title">电池优化白名单</string>
    <string name="onboarding_battery_desc">确保手机在熄屏休眠时依然维持网络串流。若缺少该权限，手机锁屏时投屏将中断。</string>
    <string name="onboarding_accessibility_title">无障碍服务</string>
    <string name="onboarding_accessibility_desc">允许车机触摸屏反向控制手机。若缺少该权限，车机上只能看画面而无法点击交互。</string>
    <string name="onboarding_notification_title">通知使用权</string>
    <string name="onboarding_notification_desc">在车机屏幕上显示手机通知。开启后，行车途中不再错过重要来电与消息。</string>
    <string name="onboarding_car_setup_title">连接前准备</string>
